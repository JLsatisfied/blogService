# 复制为 .env.development（或 .env.production）
#
# 开发数据库：
DATABASE_URL="mysql://root:password@localhost:3306/blog_service_dev"
APP_PORT=5005
JWT_SECRET=dev-strong-random-secret
JWT_EXPIRES_IN=24h
JWT_REMEMBER_EXPIRES_IN=168h

# AI 配置（可选）
AI_API_BASE=https://api.deepseek.com
AI_API_KEY=sk-your-key
AI_MODEL=deepseek-chat

# Email（可选）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-password

# 生产数据库：
# DATABASE_URL="mysql://root:password@localhost:3306/blog_service"
# JWT_SECRET=prod-strong-random-secret
